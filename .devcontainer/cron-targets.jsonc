{
  // The local cron scheduler (.devcontainer/scripts/cron.mjs) triggers a
  // Worker's triggers.crons only at the url listed here. Keys are wrangler.jsonc
  // paths relative to the workspace root. URLs are loopback IP literals
  // (127.0.0.1 or [::1]), each Worker's fixed `wrangler dev` port.
  "workers": {
    "apps/web/wrangler.jsonc": { "url": "http://127.0.0.1:8787" },
    "apps/print/wrangler.jsonc": { "url": "http://127.0.0.1:8788" },
    // "apps/jobs/wrangler.jsonc": { "url": "http://127.0.0.1:8789", "environment": "development" },
    // "apps/disabled/wrangler.jsonc": { "enabled": false },
  },
}
