{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The collector (collect.js) runs in the browser; the tests drive
    // Playwright from Node. tsconfig.consumer.json checks that callers need no
    // DOM lib.
    "lib": ["ESNext", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["src"]
}
