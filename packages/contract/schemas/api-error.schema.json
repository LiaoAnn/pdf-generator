{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Stable, machine-readable, e.g. invalid_template_pack."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable summary."
        },
        "details": {
          "description": "One entry per problem, each pointing at where it is.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "description": "Stable code of this problem, e.g. file-missing or font_not_loaded.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "file": {
                "description": "File inside the uploaded template pack.",
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?:[^/\\\\\\u0000-\\u001f\\u007f]+\\/)*[^/\\\\\\u0000-\\u001f\\u007f]+$"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "path": {
                "description": "Where in a JSON document, as keys and indexes.",
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  ]
                }
              }
            },
            "required": [
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false,
  "title": "API error",
  "description": "Body of every error response. Not expressible in JSON Schema: a detail with column also has line."
}
