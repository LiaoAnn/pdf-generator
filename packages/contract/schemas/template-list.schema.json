{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
            "description": "Lower-case kebab-case identifier, e.g. `company-monthly-report`."
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Each upload of the same id adds a version."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string"
          },
          "page": {
            "type": "object",
            "properties": {
              "size": {
                "type": "string",
                "const": "A4"
              },
              "orientation": {
                "type": "string",
                "enum": [
                  "portrait",
                  "landscape"
                ]
              }
            },
            "required": [
              "size",
              "orientation"
            ],
            "additionalProperties": false
          },
          "createdAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z(?![\\s\\S])",
            "description": "UTC time, e.g. 2026-10-23T15:46:22.998Z."
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "page",
          "createdAt"
        ],
        "additionalProperties": false,
        "title": "Template summary",
        "description": "One uploaded version of a template."
      }
    }
  },
  "required": [
    "templates"
  ],
  "additionalProperties": false,
  "title": "Template list"
}
