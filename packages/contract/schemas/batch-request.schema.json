{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "templateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Lower-case kebab-case identifier, e.g. `company-monthly-report`."
    },
    "templateVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "seed": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Seed: 1-64 of A-Z a-z 0-9 _ -."
    }
  },
  "required": [
    "templateId",
    "templateVersion",
    "count",
    "seed"
  ],
  "additionalProperties": false,
  "title": "Batch request",
  "description": "Starts a batch of fixtures from one template version and seed."
}
