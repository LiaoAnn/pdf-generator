{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "The PDF's file name."
        },
        "tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false,
          "description": "The model that found the blocks, e.g. mineru 2.5.4."
        }
      },
      "required": [
        "file",
        "tool"
      ],
      "additionalProperties": false
    },
    "pages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "width",
          "height"
        ],
        "additionalProperties": false,
        "description": "Page size in PDF points (A4 portrait: 595.28 × 841.89). Page n is pages[n - 1]."
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "description": "Unique within the document."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Page number, from 1."
          },
          "bbox": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "number",
                "minimum": 0
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4,
            "description": "[x0, y0, x1, y1] in PDF points (1/72 inch), origin at the top-left corner of the page, x to the right, y down; x0 < x1, y0 < y1."
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Reading order across the whole document, from 0; the orders of all blocks are 0..n-1."
          },
          "text": {
            "type": "string",
            "description": "Text of the block (empty for a blank field; for an image, the text inside it)."
          },
          "type": {
            "type": "string",
            "enum": [
              "title",
              "heading",
              "paragraph",
              "list_item",
              "label",
              "field",
              "table",
              "image",
              "caption",
              "formula",
              "checkbox",
              "barcode",
              "page_header",
              "page_footer",
              "page_number",
              "footnote",
              "reference"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "latex": {
            "description": "A formula as LaTeX.",
            "type": "string"
          },
          "checked": {
            "description": "A checkbox's state.",
            "type": "boolean"
          },
          "html": {
            "description": "A table's structure as HTML.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "page",
          "bbox",
          "order",
          "text",
          "type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "pages",
    "blocks"
  ],
  "additionalProperties": false,
  "title": "Block list",
  "description": "Blocks found in a real PDF by the local layout tooling, in the coordinates of gt.json. Not expressible in JSON Schema: ids are unique; the orders are a permutation of 0..n-1; page ≤ number of pages; the bbox lies inside its page (x1 ≤ width, y1 ≤ height)."
}
