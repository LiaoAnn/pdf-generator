                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "type": {
                "type": "string",
                "const": "table"
              },
              "table": {
                "type": "object",
                "properties": {
                  "rows": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "cols": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "cells": {
                    "type": "array",
