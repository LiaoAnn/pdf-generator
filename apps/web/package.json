{
  "name": "@pdf-generator/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@pdf-generator/contract": "workspace:*",
    "@pdf-generator/fake-data": "workspace:*",
    "@pdf-generator/template-tools": "workspace:*",
    "@tanstack/react-router": "^1.160.0",
    "@tanstack/react-start": "^1.160.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.0",
    "effect": "^4.0.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
