{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Not for @pdf-generator/ground-truth, which needs no DOM lib (T08-1):
    // the Node tests and vitest.config pass Node's URL where the Workers types
    // expect theirs, and template-tools' TextDecoder options miss ignoreBOM,
    // which DOM's types hide.
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["worker-configuration.d.ts", "src"]
}
