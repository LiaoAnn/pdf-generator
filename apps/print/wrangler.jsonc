{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The PDF print Worker (T07): Browser Rendering + Paged.js. The browser
  // loads fonts and Paged.js from this Worker's static assets by URL.
  "name": "pdf-generator-print",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat_v2"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8788,
    "inspector_port": 9230,
  },
}
