{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The PDF print Worker (Browser Rendering + Paged.js, T07). A placeholder
  // Worker until then.
  "name": "pdf-generator-print",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat_v2"],
  "observability": {
    "enabled": true,
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8788,
    "inspector_port": 9230,
  },
}
