{
  "schemaVersion": 1,
  "fields": {
    "reportNo": { "type": "integer", "min": 100000, "max": 999999 },
    "reportDate": { "type": "date", "min": "2026-01-01", "max": "2026-12-31" },
    "company": { "type": "company" },
    "businessId": { "type": "businessId" },
    "reporter": {
      "type": "object",
      "fields": {
        "name": { "type": "name" },
        "nationalId": { "type": "nationalId" },
        "department": {
          "type": "choice",
          "options": [
            "生產部",
            "品管部",
            "倉儲物流部",
            "設備維修部",
            "總務部",
            "研發部"
          ]
        },
        "jobTitle": {
          "type": "choice",
          "options": ["作業員", "組長", "課長", "工程師", "專員", "主任"]
        },
        "phone": { "type": "phone", "kind": "mobile" },
        "extension": {
          "type": "integer",
          "min": 100,
          "max": 899,
          "blankProbability": 0.4
        }
      }
    },
    "incident": {
      "type": "object",
      "fields": {
        "date": { "type": "date", "min": "2026-01-01", "max": "2026-12-31" },
        "time": {
          "type": "choice",
          "options": [
            "07:40",
            "08:15",
            "09:30",
            "10:05",
            "11:20",
            "13:10",
            "14:45",
            "15:30",
            "16:50",
            "18:25",
            "20:10",
            "22:35"
          ]
        },
        "address": { "type": "address" },
        "place": {
          "type": "choice",
          "options": [
            "一號廠房",
            "二號廠房",
            "原料倉庫",
            "成品倉庫",
            "裝卸區",
            "辦公大樓",
            "員工停車場"
          ],
          "blankProbability": 0.25
        },
        "category": {
          "type": "choice",
          "options": [
            "跌倒",
            "墜落",
            "被夾被捲",
            "切割擦傷",
            "感電",
            "化學品接觸",
            "其他"
          ]
        },
        "severity": {
          "type": "choice",
          "options": ["輕傷", "重傷", "死亡"],
          "weights": [7, 2, 1]
        },
        "description": {
          "type": "text",
          "phrases": [
            "夜班人員於原料倉庫以移動梯取下層架上方紗捲時",
            "梯腳於地面滑動",
            "作業人員自約一點五公尺高處跌落",
            "同組兩名人員上前攙扶時遭掉落紗捲擦撞",
            "作業人員於清理輸送帶殘料時未先停機",
            "右手遭滾輪捲入",
            "堆高機倒車時未注意後方人員",
            "推車人員閃避不及遭撞倒",
            "員工於裝卸區搬運紙箱時踩到油漬滑倒",
            "左腳踝扭傷",
            "維修人員更換配電盤保險絲時未斷電",
            "手部遭電弧灼傷",
            "作業員調配清洗劑時溶液噴濺",
            "眼睛及臉部受到刺激",
            "同仁立即以洗眼器沖洗約十五分鐘",
            "現場主管隨即通知廠護處理",
            "傷者經初步包紮後送醫",
            "已由同事陪同搭乘救護車就醫",
            "事發區域已拉起警示帶管制",
            "機台已上鎖掛牌待查",
            "工安人員到場拍照並記錄現場狀況",
            "初步研判為未依標準作業程序操作",
            "防護護罩於事發前已被拆除",
            "地面積水未即時清除",
            "人員於高架平台作業時未扣安全帶",
            "自梯子第三階踩空摔落",
            "沖床作業時手指進入模具區",
            "光電安全裝置未正常作用",
            "搬運重物時腰部突然劇痛",
            "資材堆疊過高傾倒壓傷小腿",
            "切割鋁材時砂輪片破裂飛出",
            "碎片劃傷前臂",
            "傷者意識清楚可自行行走"
          ],
          "lang": "zh",
          "minLength": 40,
          "maxLength": 120
        }
      }
    },
    "hazards": {
      "type": "object",
      "fields": {
        "machinery": { "type": "checkbox", "probability": 0.35 },
        "electrical": { "type": "checkbox", "probability": 0.35 },
        "chemical": { "type": "checkbox", "probability": 0.35 },
        "height": { "type": "checkbox", "probability": 0.35 },
        "fire": { "type": "checkbox", "probability": 0.35 }
      }
    },
    "injured": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "fields": {
          "name": { "type": "name" },
          "gender": { "type": "choice", "options": ["男", "女"] },
          "age": { "type": "integer", "min": 18, "max": 65 },
          "injury": {
            "type": "choice",
            "options": [
              "頭部挫傷",
              "手部割傷",
              "腳踝扭傷",
              "背部拉傷",
              "手指壓傷",
              "眼睛灼傷",
              "骨折",
              "擦傷"
            ]
          },
          "hospitalized": { "type": "checkbox", "probability": 0.5 },
          "note": {
            "type": "text",
            "phrases": [
              "已送醫",
              "已包紮",
              "已縫合三針",
              "住院觀察",
              "意識清楚",
              "需休養三日",
              "返家休養",
              "門診追蹤",
              "已回崗位",
              "待複診",
              "輕微擦傷",
              "已冰敷處理",
              "由家屬陪同"
            ],
            "lang": "zh",
            "minLength": 4,
            "maxLength": 10,
            "blankProbability": 0.5
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "fields": {
        "stopWork": { "type": "checkbox", "probability": 0.6 },
        "laborInspection": { "type": "checkbox", "probability": 0.5 },
        "police": { "type": "checkbox", "probability": 0.2 },
        "family": { "type": "checkbox", "probability": 0.5 }
      }
    },
    "witness": {
      "type": "object",
      "fields": {
        "name": { "type": "name", "blankProbability": 0.5 },
        "phone": { "type": "phone", "kind": "mobile", "blankProbability": 0.5 }
      }
    },
    "remarks": {
      "type": "text",
      "phrases": [
        "本案已提報職業災害通報",
        "待安衛委員會檢討改善對策",
        "已安排全廠安全教育訓練",
        "相關機台暫停使用至檢修完成",
        "請各部門加強現場巡檢",
        "後續追蹤由工安課負責",
        "已通知承攬商派員說明",
        "改善措施預計一週內完成",
        "已修訂標準作業程序",
        "傷者家屬已到院探視",
        "保險理賠資料另案辦理",
        "目擊者證詞另附書面紀錄"
      ],
      "lang": "zh",
      "minLength": 10,
      "maxLength": 60,
      "blankProbability": 0.5
    },
    "approval": {
      "type": "object",
      "fields": {
        "date": {
          "type": "date",
          "min": "2026-01-01",
          "max": "2026-12-31",
          "blankProbability": 0.4
        }
      }
    }
  }
}
