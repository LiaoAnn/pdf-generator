      "type": "paragraph"
    },
    {
      "id": "formula-4",
      "page": 2,
      "bbox": [307.55, 157.95, 544.23, 192.86],
      "order": 38,
      "text": "mAP=\n∣C∣\n1\n\n\nc∈C\n∑\n\n\n∫\n0\n1\n\n\np\nc\n\n\n(r)dr\n(4)",
      "type": "formula",
      "latex": "\\mathrm{mAP} = \\frac{1}{\\lvert C \\rvert} \\sum_{c \\in C} \\int_{0}^{1} p_c(r) \\, dr \\tag{4}"
    },
