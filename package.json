{
  "name": "pdf-generator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @pdf-generator/web dev",
    "dev:print": "pnpm --filter @pdf-generator/print dev",
    "dev:cron": "bash .devcontainer/scripts/cron.sh",
    "pdf-to-png": "node packages/dev-tools/src/cli.ts",
    "test": "vitest run && pnpm test:cron",
    "test:watch": "vitest",
    "test:cron": "node --test .devcontainer/scripts/*.test.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "knip": "knip",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "cf-typegen": "pnpm -r cf-typegen",
    "verify": "pnpm typecheck && pnpm lint && pnpm knip && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "croner": "^10.0.1",
    "jsonc-parser": "^3.3.1",
    "knip": "^6.37.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
