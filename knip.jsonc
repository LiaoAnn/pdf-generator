{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [".devcontainer/scripts/cron.mjs"],
      "project": [".devcontainer/scripts/**/*.mjs", "*.ts"],
    },
    "apps/*": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/*": {
      "project": ["src/**/*.ts"],
    },
  },
}
