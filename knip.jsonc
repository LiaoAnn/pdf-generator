{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [".devcontainer/scripts/cron.mjs"],
      "project": [".devcontainer/scripts/**/*.mjs", "*.ts"],
    },
    "apps/*": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts"],
      // `cloudflare:workers` is a workerd built-in module, not a package.
      "ignoreDependencies": ["cloudflare"],
    },
    "packages/*": {
      "project": ["src/**/*.ts"],
    },
    "packages/dev-tools": {
      "entry": ["src/cli.ts"],
      "project": ["src/**/*.ts"],
    },
    "templates/*": {
      "project": ["src/**/*.ts"],
    },
  },
}
