{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [".devcontainer/scripts/cron.mjs"],
  "project": ["src/**/*.{ts,tsx}", ".devcontainer/scripts/**/*.mjs"],
